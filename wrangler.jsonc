{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "croix",
  "compatibility_date": "2026-11-26",
  "main": "worker/index.ts",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
