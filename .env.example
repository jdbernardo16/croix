# Build-time CMS content pull (scripts/cms-pull.mjs).
#
# Set CMS_GRAPHQL_URL to pull live content. Leaving it unset fails the build
# unless CMS_ALLOW_FALLBACK is enabled and CI is not set, so production cannot
# publish the committed snapshot by accident.
CMS_GRAPHQL_URL=http://localhost:8000/graphql

# Set to 1 to fall back to the committed snapshot in app/data/fallback/ when
# the CMS is unreachable, an image cannot be downloaded, or CMS_GRAPHQL_URL is
# unset for an intentional offline build. Keep 0 for production builds so
# stale content is never shipped silently. Content validation failures never
# fall back.
CMS_ALLOW_FALLBACK=0
