# Build-time CMS content pull (scripts/cms-pull.mjs).
#
# Leave CMS_GRAPHQL_URL unset to build from the committed offline snapshot at
# app/data/fallback/content.json. Set it to pull live content instead.
CMS_GRAPHQL_URL=http://localhost:8000/public/graphql

# Set to 1 to fall back to the offline snapshot when the CMS is unreachable or
# an image cannot be downloaded. Keep 0 for production builds so stale content
# is never shipped silently. Content validation failures never fall back.
CMS_ALLOW_FALLBACK=0
