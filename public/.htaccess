# CROIX — Hostinger shared hosting (LiteSpeed/Apache)

Options -Indexes -MultiViews
DirectoryIndex index.html

# Nuxt writes /404.html during `nuxt generate`.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The contact form posts JSON to /api/contact; PHP handles it here.
  RewriteRule ^api/contact/?$ api/contact.php [L]

  # HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,QSD]

  # Canonical host: apex -> www.
  RewriteCond %{HTTP_HOST} ^croixlighting\.com\.ph$ [NC]
  RewriteRule ^ https://www.croixlighting.com.ph%{REQUEST_URI} [L,R=301,QSD]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed build assets never change.
  <FilesMatch "\.(js|css|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Never serve the Brevo key if it is accidentally placed inside the webroot.
<Files "croix-config.php">
  Require all denied
</Files>

<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>
